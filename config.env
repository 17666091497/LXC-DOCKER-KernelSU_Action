# ==================== 内核基础配置 ====================
# 小米官方开源内核仓库地址
KERNEL_SOURCE=https://github.com/MiCode/Xiaomi_Kernel_OpenSource
# 内核分支：对应Android 11(R)版本；若你是Android 12可改为 camellia-s-oss
KERNEL_BRANCH=camellia-r-oss

# 内核配置文件路径（相对于 arch/arm64/configs/ 目录）
KERNEL_CONFIG=vendor/mediatek/camellia_defconfig

# CPU架构
ARCH=arm64

# 内核镜像输出文件名（MTK平台通用格式）
KERNEL_IMAGE_NAME=Image.gz-dtb

# ==================== 编译器配置 ====================
# 使用默认官方Clang编译，4.19内核推荐Clang 12，无需改动
ENABLE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CLANG_BRANCH=master-kernel-build-2021
CLANG_VERSION=12.0.5

# GCC编译开关（Clang编译失败可尝试开启GCC）
ENABLE_GCC_64=false
ENABLE_GCC_32=false

# 额外编译参数，一般留空，特殊报错可自行添加
EXTRA_CMDS=

# 禁用LTO链接优化，编译出现LTO相关错误时设为true
DISABLE_LTO=false

# ==================== KernelSU 核心配置 ====================
# 启用KernelSU集成
ENABLE_KERNELSU=true
# KernelSU版本：稳定版推荐v0.9.5，尝鲜可填main
KERNELSU_TAG=v0.9.5

# 自动注入Kprobes配置（非GKI设备运行KernelSU必需，必须开启）
ADD_KPROBES_CONFIG=true
# 自动注入OverlayFS配置（支持system分区读写、模块挂载，建议开启）
ADD_OVERLAYFS_CONFIG=true

# 自定义KernelSU管理器签名，不需要则留空
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# ==================== 编译优化与输出 ====================
# 开启编译缓存，二次编译可节省大量时间
ENABLE_CCACHE=true

# 是否输出DTBO分区镜像，小米MTK设备一般不需要
NEED_DTBO=false

# 是否编译完整boot.img（需要源boot镜像作为底包）
BUILD_BOOT_IMG=false
# 源boot镜像直链，BUILD_BOOT_IMG=true时填写
SOURCE_BOOT_IMAGE=
